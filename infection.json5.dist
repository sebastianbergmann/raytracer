{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.32.3/resources/schema.json",
    "staticAnalysisTool": "phpstan",
    "phpStan": {
        "customPath": "tools/phpstan"
    },
    "threads": "max",
    "source": {
        "directories": [
            "src"
        ]
    },
    "mutators": {
        "@default": true,

        // The mutants that are not generated because of the settings below
        // are equivalent: they do not change what the code does

        // Camera::render() writes each pixel of the canvas that it creates,
        // so the color that the canvas is created with is never seen
        "IncrementInteger": {
            "ignoreSourceCodeByRegex": [
                "\\$canvas = Canvas::from\\(\\$this->horizontalSize, \\$this->verticalSize, Color::from\\(0, 0, 0\\)\\);"
            ]
        },
        "DecrementInteger": {
            "ignoreSourceCodeByRegex": [
                "\\$canvas = Canvas::from\\(\\$this->horizontalSize, \\$this->verticalSize, Color::from\\(0, 0, 0\\)\\);"
            ]
        },

        // Both branches calculate the same for a camera with an aspect of 1
        "GreaterThanOrEqualTo": {
            "ignoreSourceCodeByRegex": [
                "if \\(\\$this->aspect >= 1\\) \\{"
            ]
        },

        // A sum and a difference of integers are either both even or both odd
        "Plus": {
            "ignoreSourceCodeByRegex": [
                "if \\(fmod\\(floor\\(\\$point->x\\) \\+ floor\\(\\$point->y\\) \\+ floor\\(\\$point->z\\), 2\\.0\\) === 0\\.0\\) \\{",
                "if \\(\\(\\$row \\+ \\$column\\) % 2 !== 0\\) \\{"
            ]
        },

        // Matrix::determinant() calculates the determinant of a 2x2 matrix
        // directly only because this is faster
        "ReturnRemoval": {
            "ignoreSourceCodeByRegex": [
                "return \\$this->elements\\[0\\]\\[0\\] \\* \\$this->elements\\[1\\]\\[1\\] -"
            ]
        }
    },
    "minMsi": 100,
    "minCoveredMsi": 100
}
